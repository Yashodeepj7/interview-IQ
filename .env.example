# Google Gemini AI Configuration (Primary)
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Groq AI Configuration (Automatic Fallback when Gemini free tokens/quota exhaust)
# Get your free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Options: 'openai/gpt-oss-120b' (200k tokens/day, ~500 tok/s) or 'llama-3.3-70b-versatile' (100k tokens/day, ~280 tok/s)
GROQ_MODEL=openai/gpt-oss-120b

# AI Fallback Testing Simulator
# Set to 'true' to force Groq fallback immediately (ideal for testing fallback before Gemini quota ends)
FORCE_AI_FALLBACK=false

# MongoDB Atlas Integration
# Connection string from MongoDB Atlas cluster (Database Access + Network Access configured)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=interviewiq

# Auth.js / NextAuth Configuration
# Generate a secure 32-byte secret using: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# Canonical base URL for production authentication (optional in development; defaults to request origin)
AUTH_URL=http://localhost:3000
